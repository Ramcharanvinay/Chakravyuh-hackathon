# ------------------------------------------------------------------------------
# CHAKRAVYUH COLLEGE HACKATHON CONFIGURATION
# ------------------------------------------------------------------------------

# 1. Supabase Project Credentials (from your Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Spline 3D Scene URL (optional, defaults to built-in futuristic formation)
VITE_SPLINE_SCENE_URL=https://prod.spline.design/6Wq1Q7YGyM-iab9i/scene.splinecode

# Note:
# When VITE_SUPABASE_URL is not set or contains placeholders, the application
# automatically runs in a persistent Sandbox Demo Mode with full functionality
# (registration, track alignment, problem statement locking, PowerPoint uploads, receipts)
# while clearly displaying a sandbox indicator badge.
