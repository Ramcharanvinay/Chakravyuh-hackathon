# ------------------------------------------------------------------------------
# CHAKRAVYUH COLLEGE HACKATHON CONFIGURATION
# ------------------------------------------------------------------------------

# 1. Supabase Project Credentials (from your Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key. Never use the service_role/secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# 2. Spline 3D Scene URL (optional, defaults to built-in futuristic formation)
VITE_SPLINE_SCENE_URL=https://prod.spline.design/6Wq1Q7YGyM-iab9i/scene.splinecode

# Note:
# The portal has no demo/sandbox mode. If these variables are missing it shows a
# "Registration service not connected" screen instead of running.
